{
  "headerWhitespaceRule": "trim headers before dedupe and before type inference",
  "nullRule": "empty or whitespace-only cells are null; the strings N/A, null, NULL, None, -, #N/A are text",
  "emptyHeaderRule": "after trim, a header that is empty is named column; the first keeps column and later duplicates become column_2, column_3",
  "dedupeRule": "suffixes are applied after trim, in file order; the first header keeps its trimmed name and the next duplicates get _2, _3",
  "blankLineRule": "a completely empty line is skipped and is not a data row; a terminating newline after the last record is not an extra row",
  "raggedRowRule": "missing trailing cells are null; cells past the header count are ignored",
  "valueTrimRule": "only whitespace-only cells become null; surrounding spaces on a non-empty token are not stripped and would block number, date, and boolean inference",
